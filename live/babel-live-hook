#!/bin/bash
# Start the Babel live wallpaper when the Babel theme is active, stop it otherwise.
# Used as an Omarchy theme-set hook (theme slug in $1) and post-boot hook (no args).

THEME=${1:-$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)}
LIVE="$HOME/.config/omarchy/themes/babel/live/babel-live.py"
REAL=$(readlink -f "$LIVE")

# Running copies of this wallpaper, however the path to it was spelled when it started
running() {
  local pid script
  for pid in $(pgrep -f 'babel-live\.py$'); do
    script=$(tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | sed -n 2p)
    [[ -n $script && $(readlink -f "$script" 2>/dev/null) == "$REAL" ]] && echo "$pid"
  done
}

if [[ $THEME == babel ]]; then
  [[ -n $(running) ]] || setsid -f python3 "$REAL" >/dev/null 2>&1
else
  pids=$(running)
  [[ -n $pids ]] && kill $pids
fi
exit 0
